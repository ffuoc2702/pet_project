{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Connection": "Error",
        "Microsoft.EntityFrameworkCore.Query": "Error"
      }
    }
  },
  "Database": {
    "Initialize": false
  },
  "Seed": {
    "Admin": {
      "Enabled": false,
      "Email": "",
      "Password": "",
      "DisplayName": "Administrator"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60
  },
  "Auth": {
    "Jwt": {
      "Issuer": "MatchingSports",
      "Audience": "MatchingSports.Client",
      "SigningKey": "",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 30
    },
    "Otp": {
      "Pepper": "",
      "LifetimeMinutes": 10,
      "ResendCooldownSeconds": 60,
      "MaxSendsPerHour": 5,
      "MaxAttempts": 5
    },
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "CallbackPath": "/signin-google"
    },
    "Gmail": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSsl": true,
      "SenderName": "Matching Sports",
      "SenderEmail": "",
      "Username": "",
      "AppPassword": ""
    }
  },
  "AllowedHosts": "*"
}
