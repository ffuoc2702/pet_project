{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "node scripts/playwright.mjs test",
    "generate:api": "node scripts/generate-api.mjs",
    "browser:install": "node scripts/playwright.mjs install --with-deps --no-shell chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@tanstack/react-query": "^5.104.1",
    "antd": "^6.6.5",
    "bootstrap": "^5.3.8",
    "i18next": "^26.4.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^17.0.16",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/google.maps": "^3.66.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "js-yaml": "4.3.2",
    "esbuild": "0.28.1",
    "minimatch@3.1.5": {
      "brace-expansion": "2.1.7"
    },
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.7"
    }
  }
}
