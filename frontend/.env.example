VITE_APP_NAME=MatchingSports
VITE_MAP_DEFAULT_LATITUDE=10.776889
VITE_MAP_DEFAULT_LONGITUDE=106.700806
# Public build-time configuration. Production should serve web and /api on one origin.
VITE_API_BASE_URL=/api/v1
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Only used by Vite's local proxy; never placed in the browser bundle.
SERVER_HTTP=http://127.0.0.1:8080
# For an API running directly with dotnet/Aspire, replace SERVER_HTTP with:
# SERVER_HTTPS=https://localhost:7001

# Enable HTTPS when testing Google OAuth; trust the generated local certificate.
DEV_HTTPS=false
